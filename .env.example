# ============ 多 LVA 连接 ============
# 逗号分隔多个 LVA peripheral 地址；不填则用旧的 LVA_URL
LVA_URLS=
# 可选：每个 LVA 的设备名，逗号分隔；不填默认 sherpa-onnx-kws-1/-2...
LVA_NAMES=
# 可选：每个 LVA 的 UUID 持久化文件，逗号分隔；不填默认 /data/uuid_1/-2...
LVA_UUID_FILES=
# 可选：每个 LVA 的唤醒词，用 | 分隔，组内逗号分隔多词；
# 例：LVA_KEYWORDS=你好小智|小智小智,你好同学
# 不填则所有 LVA 共用下面的 KEYWORDS
LVA_KEYWORDS=
# 可选：用 | 分隔，每个 LVA 一个麦克风，例如 pulse:dev1|pulse:de或 alsa:plughw:1,0|alsa:plughw:2,0
# 不填则所有 LVA 共用下面的 AUDIO_SOURCE
LVA_AUDIO_SOURCES=
# 协议：protobuf=旧音频外设协议；json=当前 LVA 官方 JSON 协议（推荐，配合 start_listening）
LVA_PROTOCOL=json
# 可选，按 LVA 用 | 分隔覆盖协议，例如 json|protobuf
LVA_PROTOCOLS=
LVA_URL=ws://127.0.0.1:10700/api/peripheral
RECONNECT_MIN_S=1
RECONNECT_MAX_S=30

# ============ 外设身份（单 LVA 兼容） ============
DEVICE_NAME=sherpa-onnx-kws
DEVICE_UUID_FILE=/data/device_uuid
SUPPORTED_LANGUAGES=zh_CN,en_US

# ============ 唤醒 ============
# 只需填中文；启动时自动转 token。多 LVA 时可用 LVA_KEYWORDS 覆盖。
KEYWORDS=你好小智
KWS_MODEL_DIR=/opt/kws-model
KWS_NUM_THREADS=2
KWS_FAKE=0
WAKE_COOLDOWN_S=3
WAKE_BUFFER_S=2
WAKE_START_TIMEOUT_S=8

# ============ 音频 ============
AUDIO_SOURCE=pulse
AUDIO_SAMPLE_RATE=16000
CHUNK_MS=100
MAX_STREAM_SECONDS=120

# ============ 其他 ============
LOG_LEVEL=INFO
LOG_PROTOCOL_HEX=0

# ============ 构建 ============
DOWNLOAD_MODEL=1
# 模型版本（kws-models 发布资产名）；可在 Dockerfile 手动指定
# 例: MODEL_VERSION=sherpa-onnx-kws-zipformer-wenetspeech-3.3M-2024-01-01
MODEL_VERSION=sherpa-onnx-kws-zipformer-wenetspeech-3.3M-2024-01-01
APT_MIRROR=mirrors.aliyun.com
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# GH_PROXY=https://ghfast.top/

# ============ 音频硬件 ============
PULSE_SOCKET=/run/user/1000/pulse
# 留空则 compose 自动按 PULSE_SOCKET 生成 unix:<PULSE_SOCKET>/native
PULSE_SERVER=
AUDIO_GID=audio
